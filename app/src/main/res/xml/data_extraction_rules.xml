<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is backed up as usual except the crash report, which stays on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="last_crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="last_crash.txt" />
    </device-transfer>
</data-extraction-rules>
