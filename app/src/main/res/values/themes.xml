<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Metro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/metro_background</item>
        <!-- Transparent bars for Android 12 to 14; from 15 the system makes them transparent. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/metro_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/metro_light_bars</item>
        <!-- No grey scrim behind 3-button navigation: the content shows through. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- The home screen keeps an opaque window: no wallpaper compositing, cheapest to draw. -->
    <style name="Theme.Metro.Launcher">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Transparent host for confirmation dialogs drawn in Compose. -->
    <style name="Theme.Metro.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
